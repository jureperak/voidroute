{
	# Admin API is reachable only on the homepage-mgmt network (see docker-compose.yml)
	admin 172.30.254.2:2019
}

# One subdomain -> one upstream. Usage: import service <subdomain> <upstream>
(service) {
	@{args[0]} host {args[0]}.{$SERVER_NAME}
	handle @{args[0]} {
		reverse_proxy {args[1]}
	}
}

# Split-brain DNS: AdGuard rewrites *.{$SERVER_NAME} to this server, so traffic
# only ever arrives from the LAN or VPN. One wildcard cert via Porkbun DNS-01
# means ports 80/443 never need to be reachable from the internet.
*.{$SERVER_NAME} {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_API_SECRET_KEY}
		}
		# Check challenge propagation against public DNS, not AdGuard's rewrites
		resolvers 1.1.1.1 1.0.0.1
		# Let Let's Encrypt validate the record directly; Caddy's own check gets stale
		# negative answers from its resolver (see CLAUDE.md, Known gaps)
		# Porkbun publishes new TXT records with a delay; give it time before Let's Encrypt checks
		propagation_delay 120s
		propagation_timeout -1
	}

	@outside not remote_ip 192.168.8.0/24 {$VOIDROUTE_VPN_SUBNET}
	handle @outside {
		respond "Forbidden" 403
	}

	import service homepage homepage:3000
	import service adguard 192.168.8.1:3000
	import service portainer portainer:9000
	import service vault vaultwarden:80
	import service gym gym-web:80
	import service tasks vikunja:3456
	import service jellyfin jellyfin:8096
	import service jellyseerr jellyseerr:5055
	import service qbittorrent qbittorrent:8080
	import service sonarr sonarr:8989
	import service radarr radarr:7878
	import service prowlarr prowlarr:9696
	import service bazarr bazarr:6767

	handle {
		respond "Not found" 404
	}

	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		respond "<h1>{labels.2} is not available at the moment</h1>" {err.status_code}
	}
}
