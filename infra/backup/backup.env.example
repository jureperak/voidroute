# Copy to ~/.config/voidroute-backup.env on the server and adjust.
# Values must match the GitHub variables / server .env.
MEDIA_ROOT=/home/jureperak/Documents/srv
SERVER_BASE_PATH=/home/jureperak/Documents

# OneDrive via rclone (remote name "onedrive", set up with: rclone config)
RESTIC_REPOSITORY=rclone:onedrive:voidroute-backup

# File holding the restic encryption password. Keep a copy of this password
# outside the server; without it the backup cannot be restored.
RESTIC_PASSWORD_FILE=/home/jureperak/.config/restic/password
