- Calendar:
    - Calendar:
        widget:
          type: calendar
          view: monthly
          firstDayInWeek: monday
          maxEvents: 7
          showTime: true
          previousDays: 3
          integrations:
            - type: sonarr
              service_group: Media
              service_name: Sonarr
              color: teal
              params:
                unmonitored: true
            - type: radarr
              service_group: Media
              service_name: Radarr
              color: orange
              params:
                unmonitored: true

- Infra:
    - Caddy:
        icon: caddy.png
        description: Reverse proxy
        server: my-docker
        container: caddy
        widget:
          type: caddy
          url: http://172.30.254.2:2019

    - Portainer:
        icon: portainer.png
        href: https://portainer.${SERVER_NAME}
        description: Docker management
        server: my-docker
        container: portainer

    - Vaultwarden:
        icon: bitwarden.png
        href: https://vault.${SERVER_NAME}
        description: Passwords
        server: my-docker
        container: vaultwarden

    - Gym:
        icon: mdi-dumbbell
        href: https://gym.${SERVER_NAME}
        description: Workouts
        server: my-docker
        container: gym-web

    - Planner:
        icon: vikunja.png
        href: https://planner.${SERVER_NAME}
        description: Tasks, lists and notes
        server: my-docker
        container: vikunja

    - Architecture:
        icon: mdi-sitemap-outline
        href: https://homepage.${SERVER_NAME}/images/architecture.svg
        description: Stack diagram

    - Media flow:
        icon: mdi-movie-open-outline
        href: https://homepage.${SERVER_NAME}/images/media-flow.svg
        description: How a title reaches Jellyfin

- Media:
    - Jellyfin:
        icon: jellyfin.png
        href: https://jellyfin.${SERVER_NAME}
        description: Movies and TV
        server: my-docker
        container: jellyfin
        widget:
          type: jellyfin
          url: http://jellyfin:8096
          key: ${JELLYFIN_API_KEY}
          version: 2

    - Jellyseerr:
        icon: jellyseerr.png
        href: https://jellyseerr.${SERVER_NAME}
        description: Requests
        server: my-docker
        container: jellyseerr
        widget:
          type: jellyseerr
          url: http://jellyseerr:5055
          key: ${SEERR_API_KEY}

    - Sonarr:
        icon: sonarr.png
        href: https://sonarr.${SERVER_NAME}
        description: TV management
        server: my-docker
        container: sonarr
        widget:
          type: sonarr
          url: http://sonarr:8989
          key: ${SONARR_API_KEY}

    - Radarr:
        icon: radarr.png
        href: https://radarr.${SERVER_NAME}
        description: Movie management
        server: my-docker
        container: radarr
        widget:
          type: radarr
          url: http://radarr:7878
          key: ${RADARR_API_KEY}

    - Bazarr:
        icon: bazarr.png
        href: https://bazarr.${SERVER_NAME}
        description: Subtitles
        server: my-docker
        container: bazarr
        widget:
          type: bazarr
          url: http://bazarr:6767
          key: ${BAZARR_API_KEY}

    - Prowlarr:
        icon: prowlarr.png
        href: https://prowlarr.${SERVER_NAME}
        description: Indexer management
        server: my-docker
        container: prowlarr
        widget:
          type: prowlarr
          url: http://prowlarr:9696
          key: ${PROWLARR_API_KEY}

    - qBittorrent:
        icon: qbittorrent.png
        href: https://qbittorrent.${SERVER_NAME}
        description: Downloads
        server: my-docker
        container: qbittorrent
        widget:
          type: qbittorrent
          url: http://qbittorrent:8080
          username: ${QBITTORRENT_USERNAME}
          password: ${QBITTORRENT_PASSWORD}
